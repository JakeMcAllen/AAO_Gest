# Modalita' dati:
#   demo  -> tutto in localStorage, dataset di esempio precaricato (default)
#   cloud -> chiamate REST verso API Gateway (DynamoDB + S3)
VITE_DATA_MODE=demo

# Usato solo con VITE_DATA_MODE=cloud. Stesso endpoint del frontend pubblico.
VITE_API_BASE_URL=https://xxxxxxxx.execute-api.eu-west-1.amazonaws.com
